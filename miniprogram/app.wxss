page {
  --color-background: #f5f5f7;
  --color-surface: #ffffff;
  --color-text: #1d1d1f;
  --color-secondary: #626268;
  --color-primary: #0062cc;
  --color-divider: #e5e5ea;
  --radius-card: 36rpx;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  line-height: 1.6;
}

view, button, input, text {
  box-sizing: border-box;
}

button {
  width: auto;
  margin: 0;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  padding: 32rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 36rpx;
}

.section {
  margin-top: 40rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 19px;
  font-weight: 600;
}

.muted {
  color: var(--color-secondary);
}

button.primary-button {
  min-height: 44px;
  padding: 20rpx 40rpx;
  border-radius: 26rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 15px;
  line-height: 1.5;
  font-weight: 500;
}

.button-pressed {
  opacity: 0.75;
}

.preview-note {
  margin-top: 36rpx;
  color: var(--color-secondary);
  text-align: center;
  font-size: 12px;
  line-height: 1.7;
}

.login-gate {
  min-height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx 36rpx;
  border-radius: var(--radius-card);
  background: #ffffff;
  text-align: center;
}

.gate-title {
  margin-bottom: 12rpx;
  font-size: 18px;
  font-weight: 600;
}

.gate-description {
  max-width: 520rpx;
  color: var(--color-secondary);
  font-size: 13px;
}

button.gate-button {
  width: 100%;
  margin-top: 32rpx;
}
