.admin-toolbar,.row-actions,.editor-actions { display:flex; align-items:center; gap:14rpx; }
.admin-toolbar { justify-content:space-between; margin-bottom:24rpx; }
.toolbar-copy { flex:1; min-width:0; }
.section-title { margin-bottom:4rpx; font-size:18px; font-weight:600; }
.toolbar-caption,.editor-caption { color:#687078; font-size:12px; }
button.primary-button { min-height:76rpx; padding:0 22rpx; border-radius:12rpx; background:#176b52; color:#fff; line-height:76rpx; font-size:13px; }
button.add-button { display:flex; flex:none; align-items:center; justify-content:center; width:210rpx; padding:0 14rpx; }
.add-mark { margin-right:10rpx; font-size:20px; line-height:1; }
.platform-row { display:flex; flex-direction:column; align-items:stretch; gap:18rpx; margin-bottom:16rpx; padding:24rpx; }
.platform-copy { display:block; width:100%; min-width:0; overflow-wrap:anywhere; }
.row-title { font-weight:600; }
.muted { color:#687078; font-size:12px; }
.status { margin-top:8rpx; font-size:11px; }.enabled { color:#176b52; }.disabled,.error { color:#a43f35; }
.row-actions { width:100%; min-width:0; }
.row-actions button { flex:1; width:0; min-width:0; min-height:68rpx; margin:0; padding:0 12rpx; border-radius:10rpx; background:#f2f4f3; color:#39423e; font-size:13px; line-height:68rpx; box-sizing:border-box; }
.footer { padding:24rpx; text-align:center; }
.editor-backdrop { position:fixed; z-index:100; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:32rpx; background:rgba(20,28,25,.48); box-sizing:border-box; }
.editor-panel { display:flex; flex-direction:column; width:100%; max-width:640rpx; height:82vh; max-height:86vh; padding:32rpx; border-radius:20rpx; background:#fff; box-shadow:0 18rpx 64rpx rgba(0,0,0,.2); box-sizing:border-box; }
.editor-heading { flex:none; padding-bottom:20rpx; border-bottom:1rpx solid #edf0ee; }
.editor-heading .section-title { margin:0 0 4rpx; font-size:18px; }
.editor-form { flex:1; min-height:0; height:0; padding-top:16rpx; box-sizing:border-box; }
.field-label { margin:12rpx 0 8rpx; color:#333b38; font-size:13px; font-weight:600; }
.required-mark,.optional-mark { margin-left:8rpx; color:#78817d; font-size:11px; font-weight:400; }
.required-mark { color:#b24a3b; }
.editor-input,.editor-textarea { display:block; flex:none; width:100%; min-width:0; margin:0 0 18rpx; padding:18rpx 20rpx; border:1rpx solid #dfe4e1; border-radius:10rpx; background:#fff; box-sizing:border-box; font-size:14px; }
.editor-input { height:84rpx; min-height:84rpx; max-height:84rpx; }
.editor-textarea { height:190rpx; min-height:190rpx; max-height:190rpx; }
.editor-actions { flex:none; justify-content:stretch; gap:14rpx; margin-top:16rpx; padding-top:18rpx; border-top:1rpx solid #edf0ee; }
.editor-actions button { flex:1; min-width:0; height:84rpx; margin:0; padding:0 10rpx; border-radius:10rpx; font-size:14px; line-height:84rpx; }
.editor-actions .cancel-button { background:#f2f4f3; color:#3e4743; }
.editor-actions .save-button { background:#176b52; color:#fff; }

@media (max-width: 360px) {
  .editor-backdrop { padding:20rpx; }
  .editor-panel { padding:24rpx; }
  button.add-button { width:190rpx; }
}
