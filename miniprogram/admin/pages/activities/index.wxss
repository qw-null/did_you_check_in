.admin-toolbar { display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin-bottom:20rpx; }
.toolbar-copy { flex:1; min-width:0; }
.section-title { margin-bottom:4rpx; font-size:18px; font-weight:600; }
.toolbar-caption { color:#687078; font-size:12px; }
button.primary-button { min-height:76rpx; padding:0 22rpx; border-radius:12rpx; background:#176b52; color:#fff; line-height:76rpx; font-size:13px; }
button.add-button { display:flex; flex:none; align-items:center; justify-content:center; width:210rpx; padding:0 14rpx; }
.add-mark { margin-right:10rpx; font-size:20px; line-height:1; }
.status-scroll { white-space:nowrap; margin:0 -8rpx 18rpx; }.status-row { display:inline-flex; gap:8rpx; padding:8rpx; }
.status-filter { display:flex; align-items:center; min-height:64rpx; padding:0 18rpx; border-radius:12rpx; background:#fff; color:#5d646b; font-size:12px; }.status-filter.active { background:#e8f4ef; color:#155b46; }
button.review-filter { display:flex; flex:none; align-items:center; justify-content:center; width:auto; height:64rpx; min-height:64rpx; margin:0; padding:0 18rpx; border:1rpx solid #f0bc88; border-radius:12rpx; background:#fff0df; color:#a34808; font-size:12px; line-height:1; white-space:nowrap; box-sizing:border-box; }button.review-filter.active { border-color:#b94c00; background:#b94c00; color:#fff; }
.activity-row { margin-bottom:16rpx; padding:24rpx; }.activity-meta { display:flex; justify-content:space-between; gap:12rpx; font-size:11px; color:#687078; }
.row-title { margin:10rpx 0; font-weight:600; }.muted { color:#687078; font-size:12px; }.error { color:#a43f35; }.footer { padding:24rpx; text-align:center; }
button.edit-button { width:100%; margin-top:18rpx; border:1rpx solid #dfe4e1; border-radius:10rpx; background:#fff; color:#176b52; font-size:13px; }
button.text-button { display:block; margin:10rpx 0 0; padding:0; color:#176b52; font-size:12px; text-align:left; }

@media (max-width: 360px) {
  button.add-button { width:190rpx; }
}
