.section-block { margin-bottom:28rpx; padding:0 0 28rpx; border-bottom:1rpx solid #dfe3e7; }
.section-title { margin-bottom:16rpx; font-size:16px; font-weight:600; }
.section-block input,.picker-row { width:100%; min-height:82rpx; margin:12rpx 0; padding:18rpx; border:1rpx solid #dfe3e7; border-radius:10rpx; background:#fff; box-sizing:border-box; font-size:13px; }
.section-block input { height:82rpx; max-height:82rpx; flex:none; }
.section-block textarea.form-textarea { display:block; flex:none; width:100%; height:140rpx; min-height:140rpx; max-height:140rpx; margin:12rpx 0; padding:18rpx; border:1rpx solid #dfe3e7; border-radius:10rpx; background:#fff; box-sizing:border-box; font-size:13px; line-height:1.55; }
.section-block textarea.form-textarea.large-textarea { height:210rpx; min-height:210rpx; max-height:210rpx; }
.section-block textarea.form-textarea.source-textarea { height:170rpx; min-height:170rpx; max-height:170rpx; }
.section-block textarea.form-textarea.compact-textarea { height:110rpx; min-height:110rpx; max-height:110rpx; }
.picker-row { display:flex; align-items:center; color:#444b52; }
.date-row { display:flex; align-items:center; width:100%; height:88rpx; margin:12rpx 0; padding:0 8rpx 0 18rpx; border:1rpx solid #dfe3e7; border-radius:10rpx; background:#fff; box-sizing:border-box; }
.date-row picker { flex:1; min-width:0; }
.date-value { display:flex; align-items:center; height:84rpx; color:#444b52; font-size:13px; }
.date-disabled { color:#929993; }
.date-row button.date-clear { display:flex; flex:none; align-items:center; justify-content:center; width:72rpx; height:72rpx; min-height:0; margin:0; padding:0; border:0; border-radius:8rpx; background:transparent; color:#687078; font-size:22px; line-height:1; }
.date-clear text { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; border-radius:50%; background:#edf0ee; }
.field-label { margin-top:22rpx; font-size:13px; font-weight:600; }
.entry-tested { display:flex; align-items:center; padding:14rpx 0; color:#46504a; font-size:13px; }
.entry-tested checkbox { flex:none; margin-right:8rpx; }
.step-editor { padding:18rpx 0; border-bottom:1rpx solid #e0e5e2; }
.step-heading { display:flex; align-items:center; justify-content:space-between; font-size:13px; }
button.step-remove { flex:none; width:auto; min-height:64rpx; margin:0; padding:0 12rpx; background:transparent; color:#a43f35; font-size:12px; line-height:64rpx; }
van-uploader { display:block; margin-top:16rpx; --uploader-upload-background-color:#f1f6f3; --uploader-icon-color:#176b52; --uploader-text-color:#176b52; }
.status-line { margin:10rpx 0 18rpx; color:#687078; font-size:12px; }
button.wide-button { width:100%; margin:12rpx 0; border-radius:10rpx; font-size:13px; }
button.primary-button { min-height:78rpx; padding:0 18rpx; background:#176b52; color:#fff; line-height:78rpx; }
button.secondary-button { min-height:74rpx; border:1rpx solid #176b52; background:#fff; color:#176b52; line-height:72rpx; }
button.danger-button { min-height:74rpx; border:1rpx solid #bd453b; background:#fff; color:#a43f35; line-height:72rpx; }
button.plain-button { min-height:70rpx; background:#f1f3f5; color:#46505a; line-height:70rpx; }
.action-grid { display:flex; gap:12rpx; }.action-grid button { flex:1; margin:12rpx 0; font-size:12px; }
.error { margin-bottom:16rpx; color:#a43f35; }
.image-conversion-canvas { position:fixed; top:0; left:-10000px; width:1px; height:1px; opacity:0; pointer-events:none; }
