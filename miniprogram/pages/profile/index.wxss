.welcome {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
}

.avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #f2f6fc;
  border-radius: 50%;
}

.welcome-copy {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx 0 24rpx;
}

.welcome-title {
  overflow: hidden;
  margin-bottom: 12rpx;
  font-size: 18px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-badge { display: flex; align-items: center; color: var(--color-secondary); font-size: 12px; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: #21a56e; }

button.edit-button {
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #edf4ff;
  color: var(--color-primary);
  font-size: 12px;
  line-height: 1.5;
}

.profile-page .section { margin-top: 28rpx; }
.stats-card { padding: 30rpx 20rpx 24rpx; }
.stats-heading { margin: 0 12rpx 28rpx; font-size: 16px; font-weight: 600; }
.stats-grid { display: flex; }
.stat-item { flex: 1; min-width: 0; text-align: center; }
.stat-item + .stat-item { border-left: 1px solid #eef0f4; }
.stat-number { font-size: 27px; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; }
.stat-label { margin-top: 10rpx; color: var(--color-secondary); font-size: 12px; }
.stats-note { margin-top: 28rpx; color: #7a7d86; text-align: center; font-size: 10px; }

button.stats-retry {
  width: 100%;
  margin: 24rpx 0 0;
  padding: 12rpx 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 12px;
  line-height: 1.5;
}

.menu {
  overflow: hidden;
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

/* 覆盖 style:v2 的按钮默认宽度和居中边距。 */
.menu button.menu-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 112rpx;
  margin: 0;
  padding: 28rpx 32rpx;
  border-radius: 0;
  background: transparent;
  color: var(--color-text);
  text-align: left;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.5;
}

.menu-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  font-size: 17px;
  font-weight: 600;
}

.about-icon { background: #edf4ff; color: #0062cc; }
.feedback-icon { background: #eaf7f0; color: #239461; }
.menu-label { flex: 1; min-width: 0; }
.menu-divider { height: 1px; margin: 0 32rpx 0 100rpx; background: #eef0f4; }
.chevron { margin-left: 20rpx; color: #9397a0; font-size: 22px; line-height: 1; }

button.account-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 28rpx 0 0;
  padding: 20rpx 0;
  background: transparent;
  color: #7a7d86;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.6;
}

.account-action { margin-left: 16rpx; color: var(--color-primary); }
.login-gate .avatar { margin-bottom: 24rpx; }

.editor-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(20, 25, 36, 0.4);
}

.profile-editor { width: 100%; max-height: 88vh; overflow-y: auto; }
.editor-title { font-size: 19px; font-weight: 600; }
.editor-description { margin-top: 12rpx; color: var(--color-secondary); font-size: 12px; }

button.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin: 28rpx 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
}

.editor-avatar { width: 120rpx; height: 120rpx; margin-bottom: 12rpx; border-radius: 50%; }
.nickname-field { display: flex; align-items: center; padding: 24rpx; border-radius: 20rpx; background: #f5f6f8; }
.nickname-field text { margin-right: 24rpx; font-size: 14px; }
.nickname-field input { flex: 1; min-width: 0; font-size: 14px; }
.profile-error { margin-top: 16rpx; color: #c62828; font-size: 12px; }
button.save-button { width: 100%; margin-top: 32rpx; }
button.cancel-button { width: 100%; margin: 12rpx 0 0; padding: 16rpx; background: transparent; color: var(--color-secondary); font-size: 14px; font-weight: 400; line-height: 1.5; }
