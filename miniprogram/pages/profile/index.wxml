<view class="page profile-page">
  <page-header title="我的" description="把每次参与，都好好记下来。" />

  <view wx:if="{{!authenticated}}" class="login-gate">
    <image class="avatar" src="/assets/brand/avatar.png" mode="aspectFill" />
    <view class="gate-title">{{loginLoading ? '正在登录微信账号' : '欢迎来到打卡了吗'}}</view>
    <view class="gate-description">{{loginError || '登录后同步你的资料、清单与完成记录。'}}</view>
    <button class="primary-button gate-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="onLogin">{{loginLoading ? '登录中' : '微信登录'}}</button>
  </view>

  <block wx:else>
    <view class="welcome card">
      <image class="avatar" src="{{user.avatarUrl || '/assets/brand/avatar.png'}}" mode="aspectFill" aria-label="用户头像" />
      <view class="welcome-copy">
        <view class="welcome-title">{{user.displayName}}</view>
        <view class="login-badge"><view class="status-dot" />微信账号已登录</view>
      </view>
      <button class="edit-button" bindtap="onEditProfile" hover-class="button-pressed">编辑资料</button>
    </view>

    <view class="stats-card card section">
      <view class="stats-heading">我的活动</view>
      <view class="stats-grid">
        <view class="stat-item"><view class="stat-number">{{summary ? summary.joined : '—'}}</view><view class="stat-label">打卡活动</view></view>
        <view class="stat-item"><view class="stat-number">{{summary ? summary.browsed : '—'}}</view><view class="stat-label">浏览活动</view></view>
        <view class="stat-item"><view class="stat-number">{{summary ? summary.completed : '—'}}</view><view class="stat-label">完成活动</view></view>
      </view>
      <view wx:if="{{summaryLoading}}" class="stats-note">正在同步统计…</view>
      <button wx:elif="{{summaryError}}" class="stats-retry" bindtap="onRefreshSummary">{{summaryError}}</button>
      <view wx:else class="stats-note">当前加入 · 累计浏览 · 累计完成，按活动去重</view>
    </view>
  </block>

  <view class="menu section">
    <button wx:if="{{authenticated}}" class="menu-row" bindtap="onOpenHistory" hover-class="button-pressed">
      <view class="menu-icon about-icon">✓</view><text class="menu-label">打卡记录</text><text class="chevron">›</text>
    </button>
    <view wx:if="{{authenticated}}" class="menu-divider" />
    <button class="menu-row" bindtap="onOpenAbout" hover-class="button-pressed">
      <view class="menu-icon about-icon">i</view>
      <text class="menu-label">关于打卡了吗</text>
      <text class="chevron">›</text>
    </button>
    <view class="menu-divider" />
    <button class="menu-row" open-type="feedback" hover-class="button-pressed">
      <view class="menu-icon feedback-icon">✎</view>
      <text class="menu-label">意见反馈</text>
      <text class="chevron">›</text>
    </button>
  </view>

  <button wx:if="{{authenticated}}" class="account-row" bindtap="onCopyUserId" hover-class="button-pressed">
    <text>用户 ID：{{shortUserId}}</text><text class="account-action">复制</text>
  </button>
</view>

<view wx:if="{{editorOpen && authenticated}}" class="editor-backdrop" catchtap="onCloseEditor">
  <view class="profile-editor card" catchtap="onStopPropagation">
    <view class="editor-title">编辑个人资料</view>
    <view class="editor-description">头像和昵称需由你主动选择，保存后仅用于个人资料展示。</view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{profileSaving}}">
      <image class="editor-avatar" src="{{draftAvatar || user.avatarUrl || '/assets/brand/avatar.png'}}" mode="aspectFill" />
      <text>选择头像</text>
    </button>
    <form bindsubmit="onSaveProfile">
      <view class="nickname-field">
        <text>昵称</text>
        <input name="nickname" type="nickname" value="{{draftName}}" maxlength="24" placeholder="填写昵称" disabled="{{profileSaving}}" />
      </view>
      <view wx:if="{{profileError}}" class="profile-error">{{profileError}}</view>
      <button class="primary-button save-button" form-type="submit" loading="{{profileSaving}}" disabled="{{profileSaving}}">{{profileSaving ? '保存中' : '保存资料'}}</button>
      <button class="cancel-button" bindtap="onCloseEditor" disabled="{{profileSaving}}">取消</button>
    </form>
  </view>
</view>
