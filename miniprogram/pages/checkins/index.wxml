<view class="page">
  <page-header title="我的打卡" description="一份清单，记下每天的小收获。" />

  <view class="view-tabs">
    <button class="view-tab {{currentView === 'today' ? 'selected' : ''}}" data-view="today" bindtap="onViewChange" hover-class="button-pressed">今日</button>
    <button class="view-tab {{currentView === 'all' ? 'selected' : ''}}" data-view="all" bindtap="onViewChange" hover-class="button-pressed">全部</button>
  </view>

  <empty-state wx:if="{{currentView === 'today'}}" title="今日待办准备中" description="加入活动与手动完成将在云端功能接入后开放。" action-text="去活动广场" bind:action="onOpenSquare" />
  <empty-state wx:else title="个人清单准备中" description="后续可以在这里查看已加入、已完成和暂不可参与的活动。" action-text="去活动广场" bind:action="onOpenSquare" />
</view>
