.square-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin: 8rpx 0 24rpx; }
.heading-copy { flex: 1; min-width: 0; }
.heading-title { color: var(--color-text); font-size: 26px; font-weight: 600; line-height: 1.3; }
.heading-description { margin-top: 12rpx; color: var(--color-secondary); font-size: 12px; line-height: 1.6; }
.heading-caption { margin-top: 8rpx; color: #176b52; font-size: 11px; letter-spacing: 1rpx; }
.heading-brand { flex: none; width: 96rpx; height: 96rpx; border-radius: 26rpx; }
.discovery.section { margin-top: 28rpx; }
.discovery .section-title { margin-bottom: 20rpx; font-size: 17px; }

.discovery-locked {
  position: relative;
  overflow: hidden;
  min-height: 440rpx;
  border-radius: var(--radius-card);
}

.activity-placeholders {
  padding: 16rpx;
  filter: blur(5px);
}

.activity-placeholder {
  display: flex;
  align-items: center;
  min-height: 184rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.placeholder-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: #dde8f7;
}

.placeholder-lines {
  flex: 1;
  margin-left: 24rpx;
}

.placeholder-lines view {
  height: 20rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
  background: #e5e8ef;
}

.placeholder-lines view + view {
  width: 64%;
}

.discovery-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(255, 255, 255, 0.88);
}

.search-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.search-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 22rpx; border: 1rpx solid #e3e6eb; border-radius: 18rpx; background: #fff; font-size: 13px; box-sizing: border-box; }
button.search-button { flex: none; width: 104rpx; height: 76rpx; margin: 0; padding: 0; border: 0; border-radius: 18rpx; background: #176b52; color: #fff; line-height: 76rpx; font-size: 13px; }
.category-row { display: flex; gap: 10rpx; width: 100%; }
.category { display: flex; flex: 1 1 0; min-width: 0; align-items: center; justify-content: center; min-height: 64rpx; padding: 0 8rpx; border: 1rpx solid #e4e6e9; border-radius: 14rpx; background: #fff; color: #555b63; font-size: 12px; white-space: nowrap; }
.category.selected { border-color: #176b52; background: #e8f4ef; color: #155b46; font-weight: 600; }
.quick-filters { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0 20rpx; }
button.filter { width: auto; min-width: 0; height: 58rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #e2e4e8; border-radius: 14rpx; background: #fff; color: #51565e; line-height: 56rpx; font-size: 11px; }
button.filter-active { border-color: #cf694b; background: #fff0e9; color: #9d472b; }
.activity-card { margin-bottom: 14rpx; padding: 22rpx 24rpx; border: 1rpx solid #e9edf0; border-radius: 24rpx; }
.activity-card-pressed { background: #fbfcfe; }
.activity-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #737982; font-size: 11px; }
.platform-group { display: flex; align-items: center; flex: 1; min-width: 0; gap: 10rpx; }
.platform { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: #46515a; }
.completion-note { flex: none; color: #176b52; font-size: 10px; white-space: nowrap; }
.verified { flex: none; font-size: 11px; white-space: nowrap; }
.activity-title { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: 10rpx; font-size: 16px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.reward { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #a45c12; font-size: 13px; line-height: 1.6; }
.activity-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.tags { display: flex; flex: 1; flex-wrap: wrap; min-width: 0; gap: 8rpx; }
.tag { padding: 4rpx 10rpx; border-radius: 8rpx; background: #eef4fc; color: #315c91; font-size: 10px; white-space: nowrap; }
.activity-note { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; color: #737982; font-size: 11px; line-height: 1.5; }
.validity { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.eligibility { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
.list-message { margin-bottom: 18rpx; color: #9a3f34; }
button.text-button { margin: 14rpx 0 0; padding: 0; border: 0; background: transparent; color: #176b52; font-size: 13px; text-align: left; }
.list-footer { padding: 24rpx 0; text-align: center; font-size: 12px; }
button.today-summary { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 16rpx; padding: 18rpx 24rpx; border-radius: 18rpx; background: #eaf3ee; color: #176b52; font-size: 12px; text-align: left; line-height: 1.6; }
.today-summary text { flex: none; margin-left: 20rpx; font-size: 18px; }
.activity-footer button.join-button { flex: none; width: auto; min-width: 0; height: 56rpx; min-height: 0; margin: 0; padding: 0 20rpx; border-radius: 14rpx; color: #0062cc; background: #edf3fc; font-size: 11px; line-height: 56rpx; }
.activity-footer button.join-button-added { background: #f2f4f6; color: #7a838d; }
